# AlertWorker 共享配置模板（nacos-init 容器渲染后发布到 Nacos）
#
# 占位符语法：@VAR_NAME@（由 nacos-init 容器用 .env 注入的环境变量通过 sed 替换）
# 发布目标：dataId=shared-config.yaml，group=DEFAULT_GROUP，tenant=NACOS_NAMESPACE

spring:
  datasource:
    # #AI-CODE-CLASS-multi-db: URL 前缀决定数据库类型（jdbc:postgresql: / jdbc:mysql:）
    #   PostgreSQL：driver-class-name=org.postgresql.Driver
    #   MySQL 8   ：driver-class-name=com.mysql.cj.jdbc.Driver
    #               URL 建议带 useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    url: @DB_JDBC_URL@
    username: @DB_USERNAME@
    password: @DB_PASSWORD@
    driver-class-name: @DB_DRIVER@
  mail:
    host: @MAIL_HOST@
    port: @MAIL_PORT@
    username: @MAIL_USERNAME@
    password: @MAIL_PASSWORD@
    protocol: smtp
    default-encoding: UTF-8
  rabbitmq:
    host: @RABBITMQ_HOST@
    port: @RABBITMQ_PORT@
    username: @RABBITMQ_USERNAME@
    password: @RABBITMQ_PASSWORD@
    virtual-host: @RABBITMQ_VHOST@

alertworker:
  rabbitmq:
    exchange: alertworker.exchange
    routing-key: alertworker.routing.key
    queue: alertworker.queue
    dlq: alertworker.dlq
    dlx: alertworker.dlx
  # 数据加工模块：HTML 日报对象存储（上传 endpoint/bucket 与公网展示地址解耦）
  storage:
    type: @STORAGE_TYPE@
    public-base-url: @STORAGE_PUBLIC_BASE_URL@
    bucket: @STORAGE_BUCKET@
    home: @STORAGE_HOME@
    oss:
      endpoint: @OSS_ENDPOINT@
      region: @OSS_REGION@
      access-key-id: @OSS_ACCESS_KEY_ID@
      access-key-secret: @OSS_ACCESS_KEY_SECRET@
