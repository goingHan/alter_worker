# ============================================================================
# AlertWorker Docker Compose 配置
# 用法：复制本文件为 .env（与 docker-compose.yml 同目录），按需修改。
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# 时区
# ----------------------------------------------------------------------------
TZ=Asia/Shanghai

# ----------------------------------------------------------------------------
# 数据库（PostgreSQL 或 MySQL，二选一）
#   - 应用通过 JDBC URL 前缀自动识别数据库类型（jdbc:postgresql: / jdbc:mysql:）
#   - 内置 PostgreSQL（启用 db profile）：DB_JDBC_URL 保持默认 postgres 即可
#   - 内置 MySQL（启用 mysqldb profile）：取消下方 MySQL 两行注释，DB_JDBC_URL/DB_DRIVER 改为 MySQL
#   - 外部库：DB_JDBC_URL 指向外部地址（可改回 postgresql），DB_USERNAME/DB_PASSWORD 同步修改
# ----------------------------------------------------------------------------
DB_JDBC_URL=jdbc:postgresql://postgres:5432/alertworker
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=alertworker
DB_PASSWORD=alertworker
# --- 内置 MySQL（profile mysqldb）时使用下面两行，并注释掉上面两行 ---
# DB_JDBC_URL=jdbc:mysql://mysql:3306/alertworker?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# 内置 PostgreSQL 容器参数（启用 db profile 时使用；外部库忽略）
POSTGRES_DB=alertworker
POSTGRES_USER=alertworker
POSTGRES_PASSWORD=alertworker
# 内置模式时映射到宿主机的端口（外部模式忽略）
POSTGRES_PORT=5432

# 内置 MySQL 容器参数（启用 mysqldb profile 时使用；外部库忽略）
MYSQL_DATABASE=alertworker
MYSQL_USER=alertworker
MYSQL_PASSWORD=alertworker
MYSQL_ROOT_PASSWORD=alertworker
# 内置模式时映射到宿主机的端口（外部模式忽略）
MYSQL_PORT=3306

# ----------------------------------------------------------------------------
# RabbitMQ
#   - 内置模式（启用 mq profile）：RABBITMQ_HOST 保持默认 rabbitmq
#   - 外部模式：RABBITMQ_HOST 改为外部 MQ 地址
# ----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=alertworker
RABBITMQ_PASSWORD=alertworker
# 虚拟主机，/ 表示默认 vhost；注意不要有多余空格
RABBITMQ_VHOST=/
# 内置模式时映射到宿主机的端口
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ----------------------------------------------------------------------------
# Nacos 配置中心（应用启动硬依赖）
#   - 内置模式（启用 nacos profile）：NACOS_SERVER_ADDR 保持默认 nacos:8848
#   - 外部模式：改为外部地址，如 172.168.1.249:28848
# ----------------------------------------------------------------------------
NACOS_SERVER_ADDR=nacos:8848
# 命名空间 ID（必须是 namespace 的 ID，不是显示名）
NACOS_NAMESPACE=business_test
NACOS_USERNAME=nacos
NACOS_PASSWORD=123.com
# 内置 Nacos 是否开启鉴权（开启后上面用户名/密码必须与 Nacos 控制台一致）
NACOS_AUTH_ENABLE=false
# 跳过 nacos-init 自动发布共享配置（外部 Nacos 已有配置且不想被覆盖时设为 true）
NACOS_INIT_SKIP=false
# 内置模式时映射到宿主机的端口
NACOS_PORT=8848
NACOS_GRPC_PORT=9848

# ----------------------------------------------------------------------------
# SMTP 邮件通道（写入 Nacos 共享配置，Email 告警通道使用）
# ----------------------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=alerts@example.com
MAIL_PASSWORD=your-email-password

# ----------------------------------------------------------------------------
# DataManager 管理端认证
# ----------------------------------------------------------------------------
# 静态管理令牌（请求头 X-Admin-Token）；留空则使用登录令牌模式
DM_ADMIN_TOKEN=alertworker-admin-2026
DM_ADMIN_USERNAME=admin
DM_ADMIN_PASSWORD=admin123
# 登录令牌签名密钥（生产请改为随机长字符串）
DM_AUTH_SECRET=alertworker-auth-secret-2026

# ----------------------------------------------------------------------------
# 对象存储（HTML 日报托管；processor 模块使用）
#   - 本组变量仅供 nacos-init 渲染进 Nacos shared-config.yaml，运行时由 processor 从 Nacos 读取
#   - 不要注入到 processor 容器（OS 环境变量会遮蔽 Nacos）；临时覆盖请用 ALERTWORKER_STORAGE_*
#   - 上传走 endpoint/bucket；公网展示走 public-base-url（可能经自定义域名，与上传地址不同）
# ----------------------------------------------------------------------------
STORAGE_TYPE=oss
# 公网访问基址（不含 bucket；最终 URL = 基址 + /bucket + /对象键）
STORAGE_PUBLIC_BASE_URL=https://chatfiles.tydiczt.com
STORAGE_BUCKET=nbchat-prod
# 对象键前缀（写入桶内的 home 目录）
STORAGE_HOME=tmp_digital
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ----------------------------------------------------------------------------
# 种子数据（db-seed 容器幂等写入）
# ----------------------------------------------------------------------------
# 自动初始化的示例 API Key（发送告警时用 X-API-Key: <该值>）
SEED_API_KEY=alertworker-test-key

# ----------------------------------------------------------------------------
# 宿主机端口映射
# ----------------------------------------------------------------------------
# nginx（管理控制台入口，Prometheus/生产入口建议走这里）
NGINX_PORT=80
# DataManager（配置 CRUD API）
DM_PORT=8083
# Gateway（告警接入 API，外部 Alertmanager/Prometheus 直接对接时用该端口）
GW_PORT=8081
# Worker（MQ 消费与投递）
WORKER_PORT=8082
# Processor（数据加工：周期测试 / 日报生成）
PROCESSOR_PORT=8084
