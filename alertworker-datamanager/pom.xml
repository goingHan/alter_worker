<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.alertworker</groupId>
        <artifactId>alertworker-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>alertworker-datamanager</artifactId>
    <name>AlertWorker DataManager</name>

    <dependencies>
        <dependency>
            <groupId>com.alertworker</groupId>
            <artifactId>alertworker-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- #AI-CODE-CLASS-dev_release/v0.0.1-20260901: standard JWT (jjwt) replaces hand-rolled token -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <!-- #AI-CODE-CLASS-dev_release/v0.0.1-20261008: JUnit 5 for the scheduler cron helper test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- #AI-CODE-CLASS-dev_release/v0.0.1-20260804: explicit executions so repackage binds to package phase -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- #AI-CODE-CLASS-dev_release/v0.0.1-20261008: the parent pom does not inherit spring-boot-starter-parent,
                 so the default surefire 2.12.4 (no JUnit 5 support) is bound; pin 3.x here for the scheduler tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>